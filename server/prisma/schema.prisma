generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Doctor {
  id              String   @id @default(cuid())
  doctorId        String   @unique
  email           String   @unique
  password        String
  name            String
  designation     String
  specialtyCode   String
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patients        Patient[] @relation("PrimaryDoctor")
  documents       MedicalDocument[]
  visits          Visit[]
  prescriptions   Prescription[]
  accessRequests  AccessRequest[]
  patientAccesses PatientAccess[]
  auditLogs       AccessAuditLog[]

  @@index([doctorId])
  @@index([specialtyCode])
  @@index([email])
}

model Patient {
  id               String   @id @default(cuid())
  patientId        String   @unique
  primaryDoctorId  String
  primaryDoctor    Doctor   @relation("PrimaryDoctor", fields: [primaryDoctorId], references: [id])
  name             String
  dob              DateTime
  gender           String
  phone            String
  email            String   @unique
  address          String?
  emergencyContact String?
  bloodGroup       String?
  medicalInfo      String?
  password         String?
  isActivated      Boolean  @default(false)
  activationToken  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents        MedicalDocument[]
  documentTexts    DocumentText[]
  extractedEntities ExtractedEntity[]
  extractedValues  ExtractedValue[]
  medicalEvents    MedicalEvent[]
  visits           Visit[]
  prescriptions    Prescription[]
  accessRequests   AccessRequest[]
  patientAccesses  PatientAccess[]
  auditLogs        AccessAuditLog[]
  aiConversations  AIConversation[]
  aiInsights       AIInsight[]

  @@index([patientId])
  @@index([primaryDoctorId])
  @@index([email])
}

model MedicalDocument {
  id               String   @id @default(cuid())
  documentId       String   @unique
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor   @relation(fields: [doctorId], references: [id])
  fileName         String
  originalName     String
  category         String
  detectedCategory String?
  categoryConfidence Float?
  fileType         String
  filePath         String
  fileSize         Int
  uploadDate       DateTime @default(now())
  documentDate     DateTime?
  processingStatus String   @default("UPLOADED")
  extractionStatus String   @default("PENDING")
  aiConfidence     Float?
  verificationStatus String @default("PENDING")
  mismatchWarning  String?
  extractedText    String? 

  documentTexts    DocumentText[]
  extractedEntities ExtractedEntity[]
  extractedValues  ExtractedValue[]
  medicalEvents    MedicalEvent[]
  aiInsights       AIInsight[]

  @@index([patientId])
  @@index([doctorId])
  @@index([processingStatus])
  @@index([category])
}

model DocumentText {
  id           String @id @default(cuid())
  documentId   String
  document     MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pageNumber   Int
  text         String
  boundingInfo String?

  @@index([documentId])
  @@index([patientId])
}

model ExtractedEntity {
  id               String @id @default(cuid())
  patientId        String
  patient          Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentId       String
  document         MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType       String
  entityValue      String
  normalizedValue  String?
  unit             String?
  referenceRange   String?
  status           String?
  confidence       Float?
  pageNumber       Int?
  sourceText       String?
  verificationStatus String @default("AI_EXTRACTED")
  createdAt        DateTime @default(now())

  @@index([patientId])
  @@index([documentId])
  @@index([entityType])
}

model ExtractedValue {
  id               String @id @default(cuid())
  patientId        String
  patient          Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentId       String
  document         MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  testName         String
  result           String
  numericValue     Float?
  unit             String?
  referenceRange   String?
  status           String?
  testDate         DateTime?
  confidence       Float?
  pageNumber       Int?
  sourceText       String?
  verificationStatus String @default("AI_EXTRACTED")
  createdAt        DateTime @default(now())

  @@index([patientId])
  @@index([documentId])
  @@index([testName])
  @@index([testDate])
}

model MedicalEvent {
  id               String @id @default(cuid())
  eventId          String @unique
  patientId        String
  patient          Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventType        String
  eventDate        DateTime
  description      String
  doctorId         String?
  documentId       String?
  document         MedicalDocument? @relation(fields: [documentId], references: [id])
  pageNumber       Int?
  confidence       Float?
  verificationStatus String @default("AI_EXTRACTED")
  sourceReference  String?
  createdAt        DateTime @default(now())

  sourceRelationships EventRelationship[] @relation("SourceEvent")
  targetRelationships EventRelationship[] @relation("TargetEvent")

  @@index([patientId])
  @@index([eventDate])
  @@index([eventType])
  @@index([doctorId])
}

model EventRelationship {
  id               String @id @default(cuid())
  sourceEventId    String
  sourceEvent      MedicalEvent @relation("SourceEvent", fields: [sourceEventId], references: [id], onDelete: Cascade)
  targetEventId    String
  targetEvent      MedicalEvent @relation("TargetEvent", fields: [targetEventId], references: [id], onDelete: Cascade)
  relationshipType String
  description      String?
  isDocumented     Boolean @default(false)
  confidence       Float?
  createdAt        DateTime @default(now())

  @@index([sourceEventId])
  @@index([targetEventId])
}

model Visit {
  id               String @id @default(cuid())
  patientId        String
  patient          Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor @relation(fields: [doctorId], references: [id])
  date             DateTime
  reason           String?
  clinicalNotes    String?
  findings         String?
  investigations   String?
  assessment       String?
  plan             String?
  followUp         String?
  sourceType       String @default("DOCTOR_ENTERED")
  createdAt        DateTime @default(now())

  prescriptions    Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

model Prescription {
  id               String @id @default(cuid())
  patientId        String
  patient          Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor @relation(fields: [doctorId], references: [id])
  date             DateTime
  relatedVisitId   String?
  relatedVisit     Visit? @relation(fields: [relatedVisitId], references: [id])
  sourceDocumentId String?
  instructions     String?
  sourceType       String @default("DOCTOR_ENTERED")
  createdAt        DateTime @default(now())

  medications      PrescriptionMedication[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

model PrescriptionMedication {
  id             String @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication     String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  @@index([prescriptionId])
}

model AccessRequest {
  id                   String @id @default(cuid())
  doctorId             String
  doctor               Doctor @relation(fields: [doctorId], references: [id])
  patientId            String
  patient              Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status               String @default("PENDING")
  requestedAccessType  String @default("FULL")
  selectedDocuments    String?
  message              String?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([doctorId])
  @@index([patientId])
  @@index([status])
}

model PatientAccess {
  id            String @id @default(cuid())
  doctorId      String
  doctor        Doctor @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  accessType    String @default("FULL")
  selectedDocuments String?
  grantedAt     DateTime @default(now())
  expiresAt     DateTime?
  isRevoked     Boolean @default(false)
  revokedAt     DateTime?
  grantedBy     String?

  @@index([doctorId])
  @@index([patientId])
  @@index([isRevoked])
}

model AccessAuditLog {
  id            String @id @default(cuid())
  doctorId      String?
  doctor        Doctor? @relation(fields: [doctorId], references: [id])
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  action        String
  details       String?
  permissionType String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([doctorId])
  @@index([patientId])
  @@index([action])
}

model AIConversation {
  id            String @id @default(cuid())
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId        String
  userRole      String
  mode          String
  documentId    String?
  title         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      AIMessage[]

  @@index([patientId])
  @@index([userId])
  @@index([mode])
}

model AIMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        String?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model AIInsight {
  id            String @id @default(cuid())
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentId    String?
  document      MedicalDocument? @relation(fields: [documentId], references: [id])
  insightType   String
  title         String
  description   String
  confidence    Float?
  sourceReferences String?
  createdAt     DateTime @default(now())

  @@index([patientId])
  @@index([documentId])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  email     String
  role      String
  token     String @unique
  expiresAt DateTime
  used      Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}
